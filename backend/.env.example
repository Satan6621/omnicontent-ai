# ===========================================================
# OmniContent AI — Backend Environment Template
# Copy to .env and adjust values. NEVER commit real .env files.
# ===========================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=OmniContent AI
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ── Security ────────────────────────────────────────────────
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY=change-me-shared-secret-for-api-clients

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql+psycopg://omnicontent:omnicontent_secret@localhost:5432/omnicontent

# ── Celery / Redis ──────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set true ONLY for local quick tests (tasks run inline, no worker needed)
CELERY_TASK_ALWAYS_EAGER=false

# ── LLM Providers (text generation) ────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── TTS (voiceover) ────────────────────────────────────────
TTS_PROVIDER=edge-tts
TTS_VOICE=es-MX-JorgeNeural
ELEVENLABS_API_KEY=

# ── Media Generation (background visuals) ───────────────────
IMAGE_PROVIDER=pollinations
POLLINATIONS_BASE=https://image.pollinations.ai/prompt

# ── CORS / Networking ──────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Media Storage ───────────────────────────────────────────
MEDIA_ROOT=media
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
MAX_UPLOAD_MB=10

# Persistencia de media en Supabase Storage (E2). Vacío = media efímera local.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=omnicontent-media
STORAGE_PUBLIC_BASE=

# ── Puente de publicación → AutoSocial (F1/F2) ─────────────
AUTOSOCIAL_URL=https://autosocialapp.vercel.app
AUTOSOCIAL_PUBLISH_PATH=/api/publish
AUTOSOCIAL_API_KEY=change-me-autosocial-key
AUTOSOCIAL_SCHEDULE_PATH=/api/schedule
AUTOSOCIAL_ENGAGEMENT_PATH=/api/engagement

# ── Monitoreo (E6) ─────────────────────────────────────────
SENTRY_DSN=
LOG_JSON=false

# ── Servicio (Dockerfile E1/E7) ────────────────────────────
# web (default) | worker | beat
SERVICE_ROLE=web
